{
  "info": {
    "name": "Vulnapp - Local API Tests",
    "description": "For this intentionally vulnerable application in an isolated local environment only. Import and run with the Postman desktop app or Desktop Agent. Defaults target http://localhost:8080. Demo credentials are included. Login returns a random string, not a usable authenticated session: there is no token validator, session cookie, or Spring Security configuration. Requests intentionally use No Auth; the account request expects 401 even after login. Run against a fresh app for seeded data. Transfers mutate in-memory balances; restart the application to reset them. Ping requires sh and ping on the server. The file request requires a fixture and is skipped in collection runs until fileReady=true. Deserialization uses an intentionally invalid stream to verify the endpoint is reachable without including an unsafe serialized object.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "noauth" },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "username", "value": "alice", "type": "string" },
    { "key": "password", "value": "password", "type": "string" },
    { "key": "adminUsername", "value": "admin", "type": "string" },
    { "key": "adminPassword", "value": "P@ssw0rd!", "type": "string" },
    { "key": "loginToken", "value": "", "type": "string" },
    { "key": "accountUsername", "value": "alice", "type": "string" },
    { "key": "transferFrom", "value": "alice", "type": "string" },
    { "key": "transferTo", "value": "bob", "type": "string" },
    { "key": "transferAmount", "value": "1.00", "type": "string" },
    { "key": "pingHost", "value": "127.0.0.1", "type": "string" },
    { "key": "fileName", "value": "sample.txt", "type": "string" },
    { "key": "fileReady", "value": "false", "type": "string" },
    { "key": "fetchUrl", "value": "http://127.0.0.1:8080/greet?name=Postman", "type": "string" },
    { "key": "redirectTarget", "value": "/greet?name=Postman", "type": "string" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login - seeded user",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.unset('loginToken');"] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Login succeeds', () => pm.response.to.have.status(200));",
              "pm.test('Returns a hexadecimal demo token', () => pm.expect(pm.response.text()).to.match(/^[0-9a-f]{1,16}$/));",
              "if (pm.response.code === 200) pm.collectionVariables.set('loginToken', pm.response.text());"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "username", "value": "{{username}}", "type": "text" },
              { "key": "password", "value": "{{password}}", "type": "text" }
            ] },
            "url": "{{baseUrl}}/login",
            "description": "Default alice/password matches the seeded user. Stores the response in loginToken for inspection only. The app does not accept it as Bearer authentication or create a servlet Principal. Other seeded credentials: bob/abc123 and carol/12345678."
          }
        },
        {
          "name": "Login - demo admin",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Admin login succeeds', () => pm.response.to.have.status(200));",
            "pm.test('Returns a hexadecimal demo token', () => pm.expect(pm.response.text()).to.match(/^[0-9a-f]{1,16}$/));"
          ] } }],
          "request": {
            "method": "POST", "header": [],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "username", "value": "{{adminUsername}}", "type": "text" },
              { "key": "password", "value": "{{adminPassword}}", "type": "text" }
            ] },
            "url": "{{baseUrl}}/login",
            "description": "Uses the application's hard-coded demo admin credentials, not the datasource password."
          }
        },
        {
          "name": "Login - rejected credentials",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Invalid credentials are rejected', () => pm.response.to.have.status(401));",
            "pm.test('Returns rejection message', () => pm.expect(pm.response.text()).to.eql('Invalid credentials'));"
          ] } }],
          "request": {
            "method": "POST", "header": [],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "username", "value": "{{username}}", "type": "text" },
              { "key": "password", "value": "intentionally-wrong-password", "type": "text" }
            ] },
            "url": "{{baseUrl}}/login"
          }
        }
      ]
    },
    {
      "name": "Users and accounts",
      "item": [
        {
          "name": "Find seeded user",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('User lookup succeeds', () => pm.response.to.have.status(200));",
            "pm.test('Returns the requested user', () => {",
            "  const users = pm.response.json();",
            "  pm.expect(users).to.be.an('array').that.is.not.empty;",
            "  const usernames = users.map(user => user.USERNAME || user.username);",
            "  pm.expect(usernames).to.include(pm.variables.get('username'));",
            "});"
          ] } }],
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}/users?name={{username}}", "host": ["{{baseUrl}}"], "path": ["users"], "query": [{ "key": "name", "value": "{{username}}" }] }
          }
        },
        {
          "name": "Account - no authenticated principal",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Standalone app has no authenticated principal', () => pm.response.to.have.status(401));"
          ] } }],
          "request": {
            "method": "GET", "header": [], "url": "{{baseUrl}}/accounts/{{accountUsername}}",
            "description": "Expected 401 in the standalone application, including after a successful login. Access requires an external authentication layer that supplies a servlet Principal; adding arbitrary Bearer or Basic headers does not do that. If such a layer is installed, configure its actual authentication and update this assertion to suit that deployment."
          }
        }
      ]
    },
    {
      "name": "Transfers (mutates balances)",
      "item": [
        {
          "name": "Transfer between seeded accounts",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Transfer succeeds', () => pm.response.to.have.status(200));",
            "pm.test('Transfer confirmed', () => pm.expect(pm.response.text()).to.eql('Transfer complete'));"
          ] } }],
          "request": {
            "method": "POST", "header": [],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "from", "value": "{{transferFrom}}", "type": "text" },
              { "key": "to", "value": "{{transferTo}}", "type": "text" },
              { "key": "amount", "value": "{{transferAmount}}", "type": "text" }
            ] },
            "url": "{{baseUrl}}/transfer",
            "description": "No authentication is enforced. Defaults transfer 1.00 from alice (initially 1000.00) to bob (initially 500.00). Repeated runs consume the sender balance; restart the app to reset the in-memory database."
          }
        },
        {
          "name": "Transfer - unknown recipient",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Unknown recipient rejected', () => pm.response.to.have.status(400));",
            "pm.test('Explains rejection', () => pm.expect(pm.response.text()).to.eql('Unknown recipient'));"
          ] } }],
          "request": {
            "method": "POST", "header": [],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "from", "value": "{{transferFrom}}", "type": "text" },
              { "key": "to", "value": "nonexistent-postman-user", "type": "text" },
              { "key": "amount", "value": "1.00", "type": "text" }
            ] },
            "url": "{{baseUrl}}/transfer"
          }
        }
      ]
    },
    {
      "name": "Utilities",
      "item": [
        {
          "name": "Greeting",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Greeting succeeds', () => pm.response.to.have.status(200));",
            "pm.test('Contains supplied name', () => pm.expect(pm.response.text()).to.include('Hello Postman'));"
          ] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/greet?name=Postman", "host": ["{{baseUrl}}"], "path": ["greet"], "query": [{ "key": "name", "value": "Postman" }] } }
        },
        {
          "name": "Encrypt demo text",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Encryption succeeds', () => pm.response.to.have.status(200));",
            "pm.test('Returns nonempty Base64 ciphertext', () => pm.expect(pm.response.text()).to.match(/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/));",
            "pm.test('Ciphertext is not empty', () => pm.expect(pm.response.text()).not.to.eql(''));"
          ] } }],
          "request": {
            "method": "POST", "header": [],
            "body": { "mode": "urlencoded", "urlencoded": [{ "key": "value", "value": "hello-postman", "type": "text" }] },
            "url": "{{baseUrl}}/encrypt"
          }
        },
        {
          "name": "Parse benign XML",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('XML parsing succeeds', () => pm.response.to.have.status(200));",
            "pm.test('Returns element text', () => pm.expect(pm.response.text()).to.eql('Hello Postman'));"
          ] } }],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/xml" }],
            "body": { "mode": "raw", "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<message>Hello Postman</message>", "options": { "raw": { "language": "xml" } } },
            "url": "{{baseUrl}}/xml"
          }
        },
        {
          "name": "Fetch local greeting from server",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Fetch succeeds', () => pm.response.to.have.status(200));",
            "pm.test('Fetched greeting content', () => pm.expect(pm.response.text()).to.include('Hello Postman'));"
          ] } }],
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}/fetch?url={{fetchUrl}}", "host": ["{{baseUrl}}"], "path": ["fetch"], "query": [{ "key": "url", "value": "{{fetchUrl}}" }] },
            "description": "fetchUrl is resolved from the application server, not Postman. Its default calls this application's local greeting on port 8080. Adjust it separately if the server listens on another port; keep the name=Postman query for the assertion."
          }
        },
        {
          "name": "Redirect to local greeting",
          "protocolProfileBehavior": { "followRedirects": false },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Returns redirect without following it', () => pm.response.to.have.status(302));",
            "pm.test('Location contains configured target', () => pm.expect(pm.response.headers.get('Location')).to.include(pm.variables.get('redirectTarget')));"
          ] } }],
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}/redirect?target={{redirectTarget}}", "host": ["{{baseUrl}}"], "path": ["redirect"], "query": [{ "key": "target", "value": "{{redirectTarget}}" }] },
            "description": "Redirect following is disabled for this request so the 302 and Location header can be checked."
          }
        },
        {
          "name": "Download fixture (opt-in)",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "if (pm.variables.get('fileReady') !== 'true') {",
              "  console.warn('Skipped: create sample.txt in the server app.files.base-dir, then set fileReady=true.');",
              "  pm.execution.skipRequest();",
              "}"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('File downloaded', () => pm.response.to.have.status(200));"] } }
          ],
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}/files?name={{fileName}}", "host": ["{{baseUrl}}"], "path": ["files"], "query": [{ "key": "name", "value": "{{fileName}}" }] },
            "description": "Create sample.txt in the SERVER's app.files.base-dir (default /tmp/vulnapp-files), then set fileReady to the string true. A missing file produces 500 in this application. Nothing is uploaded by this collection."
          }
        },
        {
          "name": "Deserialize - invalid stream (expected 500)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Current app returns 500 for an invalid serialization stream', () => pm.response.to.have.status(500));"
          ] } }],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/octet-stream" }],
            "body": { "mode": "raw", "raw": "not-a-java-serialization-stream" },
            "url": "{{baseUrl}}/deserialize",
            "description": "Negative test only: the current controller lets StreamCorruptedException become HTTP 500. This assertion documents current behavior, not desirable error handling. For a success test, change Body to binary and select a trusted Java ObjectOutputStream file containing a simple String; expected result is 200 with 'Deserialized: java.lang.String'. JSON and Base64 text are not Java serialization streams. Do not submit untrusted serialized objects."
          }
        }
      ]
    }
  ]
}